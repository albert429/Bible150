# Optional public HTTPS audio CDN origin. No credentials; included in the bundle.
# Leave unset to serve audio from this deployment's /audio/days/ directory.
# Set to / to enable the same-origin Vercel media rewrite without local media.
# VITE_AUDIO_BASE_URL=https://audio.example.org

# Optional AI explanations («اسأل الذكاء الاصطناعي»). Leave VITE_AI_PROVIDERS
# empty (the default) to build without them.
#
# Every VITE_* value is compiled into the public JavaScript: the key is visible
# to anyone. Use a dedicated OpenRouter key with a $0 credit limit (see
# docs/development.md). Never commit a real key; for local testing put it in
# .env.development.local, which `npm run dev` reads and `npm run build` does not.

VITE_AI_PROVIDERS=
VITE_OPENROUTER_API_KEY=
# Up to two ":free" models, tried in order before openrouter/free.
# Empty uses the defaults in src/ai/config.ts.
VITE_OPENROUTER_MODELS=
# Answers per device per day (1–100). Empty means 10.
VITE_AI_DAILY_CAP=
